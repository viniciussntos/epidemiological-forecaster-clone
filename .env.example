# Backend FastAPI e pipeline automatizado. No Supabase, copie a URL do
# "Session pooler" (porta 5432) para compatibilidade com redes IPv4.
DATABASE_URL=postgresql://postgres.projeto:senha@host.pooler.supabase.com:5432/postgres?sslmode=require
EVALUATION_LAG_WEEKS=4
MIN_PRODUCTION_EVALUATION_WEEKS=4
API_CACHE_TTL_SECONDS=300

# Frontend Streamlit
API_URL=https://sua-api.onrender.com
